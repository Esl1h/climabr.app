{
  "extends": "astro/tsconfigs/strict",
  "include": ["**/*.ts"],
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
