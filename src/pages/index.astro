---
import PainelLayout from '../layouts/PainelLayout.astro';
import {
  lerTodas,
  capitaisAgora,
  corAqiTexto,
  corReservatorioTexto,
  corFocosTexto,
  corDengueTexto,
} from '../lib/destaques';

const capitais = await capitaisAgora();
const todas = await lerTodas();

// Destaques nacionais (gerados no build, 2x/dia)
const reservatoriosBaixos = todas
  .filter((c) => c.reservatorioPct != null && c.reservatorioPct < 50 && !c.reservatorioAproximado)
  .sort((a, b) => (a.reservatorioPct ?? 0) - (b.reservatorioPct ?? 0))
  .slice(0, 5);

const maisFocos = todas
  .filter((c) => (c.focos ?? 0) > 0)
  .sort((a, b) => (b.focos ?? 0) - (a.focos ?? 0))
  .slice(0, 5);

const dengueAlerta = todas
  .filter((c) => (c.dengueNivel ?? 0) >= 2)
  .sort((a, b) => (b.dengueCasos ?? 0) - (a.dengueCasos ?? 0))
  .slice(0, 5);

const totalDengueAlerta = todas.filter((c) => (c.dengueNivel ?? 0) >= 2).length;

// Avisos meteorológicos ativos por UF (INMET, gerados por scripts/scrape-alertas.py)
interface AvisoResumo { evento: string; nivel: number; fim: string | null }
const alertaModulos = import.meta.glob<{ default: AvisoResumo[] }>(
  '../../data/alertas/*.json',
  { eager: true }
);
const agoraTs = Date.now();
const ufsAlerta = Object.entries(alertaModulos)
  .flatMap(([caminho, mod]) => {
    const uf = caminho.split('/').pop()!.replace('.json', '');
    const ativos = mod.default.filter((a) => !a.fim || Date.parse(a.fim) > agoraTs);
    if (ativos.length === 0) return [];
    const pior = ativos.reduce((m, a) => (a.nivel > m.nivel ? a : m));
    const fimMax = ativos.reduce<string | null>(
      (m, a) => (a.fim && (!m || a.fim > m) ? a.fim : m), null);
    return [{ uf, total: ativos.length, pior, fimMax }];
  })
  .sort((a, b) => b.pior.nivel - a.pior.nivel || b.total - a.total);

// 1=Perigo Potencial, 2=Perigo, 3=Grande Perigo
const ALERTA_CHIP: Record<number, string> = {
  1: 'text-status-moderado border-status-moderado/40 bg-status-moderado/10',
  2: 'text-status-ruim border-status-ruim/40 bg-status-ruim/10',
  3: 'text-status-critico border-status-critico/40 bg-status-critico/10',
};

const geradoEm = new Date().toLocaleString('pt-BR', {
  day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
  timeZone: 'America/Sao_Paulo',
});
---

<PainelLayout title="Previsão do Tempo e Qualidade do Ar por Cidade | ClimaBR.app">
  <div class="space-y-10">
    <div class="mx-auto max-w-xl space-y-8">
      <div class="text-center space-y-2">
        <h1 class="text-3xl font-bold">
          <span class="italic text-emerald-700 dark:text-emerald-500">Clima</span><span class="italic text-blue-600 dark:text-blue-500">BR</span><span class="text-yellow-600 dark:text-yellow-500">.app</span>
        </h1>
        <p class="text-muted-foreground">Previsão do tempo e painel ambiental para todas as 5.571 cidades brasileiras: qualidade do ar, água, clima e alertas</p>
      </div>

      <div class="relative">
        <label for="busca-home" class="sr-only">Buscar cidade</label>
        <input
          id="busca-home"
          data-busca-cidade
          type="search"
          placeholder="Digite sua cidade..."
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="busca-home-lista"
          aria-autocomplete="list"
          class="w-full rounded-lg border border-input bg-card px-4 py-3 text-base text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
        />
        <ul
          id="busca-home-lista"
          role="listbox"
          aria-label="Resultados da busca"
          class="hidden absolute left-0 right-0 top-14 max-h-80 overflow-y-auto bg-popover border border-border rounded-lg shadow-xl z-50 py-1"
        ></ul>
      </div>

      <button
        id="btn-geo"
        class="w-full rounded-lg border border-input bg-card px-4 py-2.5 text-sm text-foreground/80 hover:bg-accent hover:text-foreground transition-colors"
      >
        📍 Usar minha localização
      </button>

      <div id="recentes" class="hidden space-y-2">
        <p class="text-xs text-muted-foreground uppercase tracking-wide">Recentes</p>
        <div id="recentes-chips" class="flex flex-wrap gap-2"></div>
      </div>
    </div>

    <!-- Alertas meteorológicos ativos por estado (INMET) -->
    {ufsAlerta.length > 0 && (
      <section aria-label="Alertas meteorológicos" data-alertas-home>
        <h2 class="mb-3 text-base font-semibold text-foreground">
          <span aria-hidden="true">⚠️</span> Alertas meteorológicos ativos
        </h2>
        <div class="flex flex-wrap gap-2">
          {ufsAlerta.map((u) => (
            <a
              href={`/${u.uf}`}
              data-alerta-uf
              data-fim={u.fimMax}
              class={`rounded-full border px-3 py-1.5 text-sm transition-colors hover:opacity-80 ${ALERTA_CHIP[u.pior.nivel] ?? ALERTA_CHIP[1]}`}
            >
              <strong>{u.uf.toUpperCase()}</strong> · {u.pior.evento}{u.total > 1 ? ` +${u.total - 1}` : ''}
            </a>
          ))}
        </div>
        <p class="mt-2 text-xs text-muted-foreground">Avisos oficiais do INMET · clique na UF para detalhes</p>
      </section>
    )}

    <!-- Capitais agora: gerado no build a partir dos dados coletados -->
    <section aria-label="Capitais agora">
      <h2 class="mb-3 text-base font-semibold text-foreground">Capitais agora</h2>
      <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-5">
        {capitais.map((c) => (
          <a
            href={`/${c.uf}/${c.slug}`}
            class="rounded-lg border border-border bg-card px-2.5 py-2 hover:bg-accent transition-colors"
          >
            <p class="truncate text-xs font-medium text-foreground/80">{c.nome}</p>
            <p class="mt-0.5 flex items-baseline gap-2">
              <span class="text-sm font-bold tabular-nums text-foreground">{c.temperatura != null ? `${Math.round(c.temperatura)}°` : '—'}</span>
              {c.aqi != null && (
                <span class={`text-xs font-semibold tabular-nums ${corAqiTexto(c.aqi)}`} title={`Qualidade do ar: ${c.aqiCategoria ?? ''}`}>
                  AQI {c.aqi}
                </span>
              )}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Destaques nacionais -->
    <section aria-label="Destaques nacionais">
      <div class="mb-3 flex items-baseline justify-between">
        <h2 class="text-base font-semibold text-foreground">Brasil agora</h2>
        <a href="/rankings" class="text-sm text-primary hover:underline">Rankings completos →</a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {reservatoriosBaixos.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-4">
            <h3 class="mb-2 text-sm font-semibold text-foreground"><span aria-hidden="true">🌊</span> Reservatórios em atenção</h3>
            <ul class="space-y-1.5">
              {reservatoriosBaixos.map((c) => (
                <li>
                  <a href={`/${c.uf}/${c.slug}`} class="flex items-center justify-between gap-2 text-sm hover:text-primary transition-colors">
                    <span class="truncate text-foreground/80">{c.nome}/{c.uf.toUpperCase()}</span>
                    <span class={`shrink-0 font-semibold tabular-nums ${corReservatorioTexto(c.reservatorioPct!)}`}>{c.reservatorioPct!.toFixed(1)}%</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {maisFocos.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-4">
            <h3 class="mb-2 text-sm font-semibold text-foreground"><span aria-hidden="true">🔥</span> Mais focos de queimada</h3>
            <ul class="space-y-1.5">
              {maisFocos.map((c) => (
                <li>
                  <a href={`/${c.uf}/${c.slug}`} class="flex items-center justify-between gap-2 text-sm hover:text-primary transition-colors">
                    <span class="truncate text-foreground/80">{c.nome}/{c.uf.toUpperCase()}</span>
                    <span class={`shrink-0 font-semibold tabular-nums ${corFocosTexto(c.focos!)}`}>{c.focos} focos</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {dengueAlerta.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-4">
            <h3 class="mb-2 text-sm font-semibold text-foreground"><span aria-hidden="true">🦟</span> Dengue em alerta</h3>
            <ul class="space-y-1.5">
              {dengueAlerta.map((c) => (
                <li>
                  <a href={`/${c.uf}/${c.slug}`} class="flex items-center justify-between gap-2 text-sm hover:text-primary transition-colors">
                    <span class="truncate text-foreground/80">{c.nome}/{c.uf.toUpperCase()}</span>
                    <span class={`shrink-0 font-semibold ${corDengueTexto(c.dengueNivel!)}`}>{c.dengueLabel ?? `Nível ${c.dengueNivel}`}</span>
                  </a>
                </li>
              ))}
            </ul>
            {totalDengueAlerta > 5 && (
              <p class="mt-2 text-xs text-muted-foreground">e mais {totalDengueAlerta - 5} municípios em alerta</p>
            )}
          </div>
        )}
      </div>
      <p class="mt-2 text-xs text-muted-foreground">Gerado em {geradoEm} · atualiza 2x ao dia</p>
    </section>

    <p class="text-center text-xs text-muted-foreground">
      Sua cidade fica salva localmente, sem conta e sem rastreamento.
    </p>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ClimaBR.app",
    "url": "https://climabr.app",
    "description": "Previsão do tempo e painel ambiental para todas as 5.571 cidades brasileiras: qualidade do ar, água, clima e alertas.",
    "inLanguage": "pt-BR",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://climabr.app/?q={termo}" },
      "query-input": "required name=termo",
    },
  })} />
</PainelLayout>

<script>
  import { carregarIndice, maisProxima } from '../scripts/busca-cidades';

  // Chips de cidades visitadas recentemente (gravadas pela página de cidade)
  function renderizarRecentes(): void {
    const wrap = document.getElementById('recentes');
    const chips = document.getElementById('recentes-chips');
    if (!wrap || !chips) return;
    let recentes: { uf: string; slug: string; nome: string }[] = [];
    try { recentes = JSON.parse(localStorage.getItem('climabr_recentes') ?? '[]'); } catch { /* ignora */ }
    if (!Array.isArray(recentes) || recentes.length === 0) return;
    chips.innerHTML = '';
    for (const r of recentes.slice(0, 5)) {
      if (!r?.uf || !r?.slug || !r?.nome) continue;
      const a = document.createElement('a');
      a.href = `/${r.uf}/${r.slug}`;
      a.className = 'rounded-full border border-input bg-card px-3 py-1.5 text-sm text-foreground/80 hover:bg-accent hover:text-foreground transition-colors';
      a.textContent = `${r.nome}/${r.uf.toUpperCase()}`;
      chips.appendChild(a);
    }
    wrap.classList.toggle('hidden', chips.children.length === 0);
  }

  // Placeholder com exemplos rotativos; para na primeira interação
  const EXEMPLOS = ['Cotia', 'Manaus', 'Pelotas', 'Petrolina', 'Sinop', 'Ilhéus'];
  let rotacao: ReturnType<typeof setInterval> | null = null;

  function initBuscaHome(): void {
    const input = document.getElementById('busca-home') as HTMLInputElement | null;
    if (!input || input.dataset.init) return;
    input.dataset.init = '1';

    // Autofoco só em telas largas (no celular abriria o teclado sem pedir)
    if (matchMedia('(min-width: 640px)').matches) input.focus();

    // Busca via URL (?q=cidade), usada pela SearchAction do JSON-LD
    const q = new URLSearchParams(location.search).get('q');
    if (q && !input.value) {
      input.value = q;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }

    let i = 0;
    if (rotacao) clearInterval(rotacao);
    rotacao = setInterval(() => {
      if (input.value || document.activeElement === input) return;
      i = (i + 1) % EXEMPLOS.length;
      input.placeholder = `Digite sua cidade... ex.: ${EXEMPLOS[i]}`;
    }, 3000);
  }

  // Home é estática (build 2x/dia): remove chips de alerta já vencidos
  function limparAlertasVencidos(): void {
    const secao = document.querySelector<HTMLElement>('[data-alertas-home]');
    if (!secao) return;
    secao.querySelectorAll<HTMLElement>('[data-alerta-uf]').forEach((el) => {
      const fim = el.dataset.fim;
      if (fim && Date.parse(fim) < Date.now()) el.remove();
    });
    if (!secao.querySelector('[data-alerta-uf]')) secao.remove();
  }

  function initHome(): void {
    renderizarRecentes();
    initBuscaHome();
    limparAlertasVencidos();
  }

  initHome();
  document.addEventListener('astro:page-load', initHome);

  // Geolocalização: acha o município mais próximo no índice, tudo no cliente;
  // a permissão é pedida pelo próprio navegador e nada sai do dispositivo
  document.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('#btn-geo') : null;
    if (!btn) return;
    if (!('geolocation' in navigator)) {
      btn.textContent = 'Geolocalização indisponível neste navegador';
      btn.disabled = true;
      return;
    }
    btn.disabled = true;
    btn.textContent = '📍 Localizando…';
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        await carregarIndice();
        const cidade = maisProxima(pos.coords.latitude, pos.coords.longitude);
        if (cidade) {
          window.location.href = `/${cidade.uf}/${cidade.slug}`;
        } else {
          btn.textContent = 'Não foi possível localizar; use a busca';
          btn.disabled = false;
        }
      },
      () => {
        btn.textContent = 'Permissão negada; use a busca acima';
        btn.disabled = false;
      },
      { timeout: 10000, maximumAge: 300000 }
    );
  });
</script>
