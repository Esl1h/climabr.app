---
import PainelLayout from '../layouts/PainelLayout.astro';
import {
  lerTodas,
  capitaisAgora,
  corAqiTexto,
  corReservatorioTexto,
  corFocosTexto,
  corDengueTexto,
} from '../lib/destaques';
import { corTemperaturaTexto, catTemperatura } from '../lib/temperatura';

const capitais = await capitaisAgora();
const todas = await lerTodas();

// Destaques nacionais (gerados no build, 2x/dia)
const reservatoriosBaixos = todas
  .filter((c) => c.reservatorioPct != null && c.reservatorioPct < 50 && !c.reservatorioAproximado)
  .sort((a, b) => (a.reservatorioPct ?? 0) - (b.reservatorioPct ?? 0))
  .slice(0, 5);

const maisFocos = todas
  .filter((c) => (c.focos ?? 0) > 0)
  .sort((a, b) => (b.focos ?? 0) - (a.focos ?? 0))
  .slice(0, 5);

const dengueAlerta = todas
  .filter((c) => (c.dengueNivel ?? 0) >= 2)
  .sort((a, b) => (b.dengueCasos ?? 0) - (a.dengueCasos ?? 0))
  .slice(0, 5);

const totalDengueAlerta = todas.filter((c) => (c.dengueNivel ?? 0) >= 2).length;

// Avisos meteorológicos ativos por UF (INMET, gerados por scripts/scrape-alertas.py)
interface AvisoResumo { evento: string; nivel: number; fim: string | null }
const alertaModulos = import.meta.glob<{ default: AvisoResumo[] }>(
  '../../data/alertas/*.json',
  { eager: true }
);
const agoraTs = Date.now();
const ufsAlerta = Object.entries(alertaModulos)
  .flatMap(([caminho, mod]) => {
    const uf = caminho.split('/').pop()!.replace('.json', '');
    const ativos = mod.default.filter((a) => !a.fim || Date.parse(a.fim) > agoraTs);
    if (ativos.length === 0) return [];
    const pior = ativos.reduce((m, a) => (a.nivel > m.nivel ? a : m));
    const fimMax = ativos.reduce<string | null>(
      (m, a) => (a.fim && (!m || a.fim > m) ? a.fim : m), null);
    return [{ uf, total: ativos.length, pior, fimMax }];
  })
  .sort((a, b) => b.pior.nivel - a.pior.nivel || b.total - a.total);

// 1=Perigo Potencial, 2=Perigo, 3=Grande Perigo
const ALERTA_CHIP: Record<number, string> = {
  1: 'text-status-moderado border-status-moderado/40 bg-status-moderado/10',
  2: 'text-status-ruim border-status-ruim/40 bg-status-ruim/10',
  3: 'text-status-critico border-status-critico/40 bg-status-critico/10',
};

const geradoEm = new Date().toLocaleString('pt-BR', {
  day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
  timeZone: 'America/Sao_Paulo',
});

// Chips ao vivo do topo: três capitais de referência + o aviso mais grave do dia
const chipsTopo = ['sao-paulo', 'rio-de-janeiro', 'brasilia']
  .map((s) => capitais.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => c != null);
---

<PainelLayout larga title="Previsão do Tempo e Qualidade do Ar por Cidade | ClimaBR.app">
  <div class="space-y-10">
    <div class="relative isolate">
      <!-- Fundo: degradê de céu + malha de pontos com máscara radial (decorativo) -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-6 -z-10 h-[34rem] rounded-3xl bg-linear-to-b from-status-info/12 via-primary/5 to-transparent"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-6 -z-10 h-[34rem]" style="background-image: radial-gradient(color-mix(in oklab, var(--foreground) 22%, transparent) 1px, transparent 1px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 20%, black 25%, transparent 75%); mask-image: radial-gradient(ellipse 70% 70% at 50% 20%, black 25%, transparent 75%);"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-2 py-12 sm:py-16 lg:grid-cols-[1fr_0.9fr]">
    <div class="mx-auto w-full max-w-xl space-y-8">
      <div class="text-center space-y-3 lg:text-left">
        <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight">
          <span>Clima</span><span class="text-primary">BR</span><span class="font-medium text-muted-foreground">.app</span>
        </h1>
        <p class="text-lg text-muted-foreground">Previsão do tempo e painel ambiental para todas as 5.571 cidades brasileiras: qualidade do ar, água, clima e alertas</p>
      </div>

      <div class="relative">
        <label for="busca-home" class="sr-only">Buscar cidade</label>
        <input
          id="busca-home"
          data-busca-cidade
          type="search"
          placeholder="Digite sua cidade..."
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="busca-home-lista"
          aria-autocomplete="list"
          class="w-full rounded-full border border-input bg-card/70 backdrop-blur-md px-6 py-4 text-base text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
        />
        <ul
          id="busca-home-lista"
          role="listbox"
          aria-label="Resultados da busca"
          class="hidden absolute left-0 right-0 top-14 max-h-80 overflow-y-auto bg-popover border border-border rounded-lg shadow-xl z-50 py-1"
        ></ul>
      </div>

      <button
        id="btn-geo"
        aria-live="polite"
        class="w-full rounded-full border border-input bg-card/70 backdrop-blur-md px-4 py-3 text-sm text-foreground/80 hover:bg-accent hover:text-foreground transition-colors"
      >
        📍 Usar minha localização
      </button>


      <div id="recentes" class="hidden space-y-2">
        <a
          id="minha-cidade"
          href="/"
          class="hidden items-center justify-between gap-3 rounded-lg border border-primary/40 bg-card px-4 py-3 hover:bg-accent transition-colors"
        >
          <span class="min-w-0">
            <span class="block text-sm text-muted-foreground">Minha cidade</span>
            <span id="minha-cidade-nome" class="block truncate font-semibold text-foreground"></span>
          </span>
          <span aria-hidden="true" class="text-primary">→</span>
        </a>
        <p class="text-sm text-muted-foreground">Recentes</p>
        <div id="recentes-chips" class="flex flex-wrap gap-2"></div>
      </div>
    </div>
        <a href="/sp/sao-paulo/telao" class="group hidden lg:block" aria-label="Ver exemplo do Modo Painel">
          <img src="/exemplo-modo-painel.webp" width="1600" height="1000" alt="Exemplo do Modo Painel de São Paulo, com previsão, ar, UV, vento, represa, queimadas e dengue" class="h-auto w-full -rotate-1 rounded-2xl border border-border shadow-2xl transition-transform duration-300 group-hover:rotate-0 group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:transform-none" />
        </a>
      </div>

      <div class="relative mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-2 px-2 pb-6 lg:justify-start" aria-label="Agora em algumas capitais">
        <span class="text-sm text-muted-foreground">Agora:</span>
        {chipsTopo.map((c) => (
          <a href={`/${c.uf}/${c.slug}`} data-agora data-lat={c.latitude} data-lon={c.longitude} class="inline-flex items-baseline gap-2 rounded-full border border-border bg-card/70 px-4 py-2 text-sm backdrop-blur-md transition hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none">
            <span class="font-medium text-foreground/80">{c.nome}</span>
            <span data-agora-temp class={`font-bold tabular-nums ${c.temperatura != null ? corTemperaturaTexto(c.temperatura) : ''}`}>{c.temperatura != null ? `${Math.round(c.temperatura)}°` : '—'}</span>
            <span data-agora-aqi hidden={c.aqi == null} class={`text-xs font-semibold tabular-nums ${c.aqi != null ? corAqiTexto(c.aqi) : ''}`}>{c.aqi != null ? `AQI ${c.aqi}` : ''}</span>
          </a>
        ))}
        {ufsAlerta.length > 0 && (
          <a href={`/${ufsAlerta[0].uf}`} class={`inline-flex items-center gap-1 rounded-full border px-4 py-2 text-sm font-medium backdrop-blur-md transition hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:transform-none ${ALERTA_CHIP[ufsAlerta[0].pior.nivel] ?? ALERTA_CHIP[1]}`}>
            Aviso mais grave: {ufsAlerta[0].pior.evento} em {ufsAlerta[0].uf.toUpperCase()}
          </a>
        )}
      </div>
    </div>

    <!-- Alertas meteorológicos ativos por estado (INMET) -->
    {ufsAlerta.length > 0 && (
      <section aria-label="Alertas meteorológicos" data-alertas-home>
        <h2 class="mb-3 text-sm font-medium text-muted-foreground">
          Alertas meteorológicos ativos
        </h2>
        <!-- No celular a lista começa recolhida, para as capitais aparecerem na primeira dobra; no desktop abre sozinha -->
        <details data-alertas-detalhes open>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-lg border border-status-moderado/40 bg-status-moderado/10 px-3 py-2 text-sm sm:hidden [&::-webkit-details-marker]:hidden">
            <span>
              <strong>{ufsAlerta.length} {ufsAlerta.length === 1 ? 'UF' : 'UFs'}</strong> com aviso · maior: {ufsAlerta[0].pior.evento} ({ufsAlerta[0].uf.toUpperCase()})
            </span>
            <span aria-hidden="true">▾</span>
          </summary>
          <div class="mt-2 flex flex-wrap gap-2 sm:mt-0">
            {ufsAlerta.map((u) => (
              <a
                href={`/${u.uf}`}
                data-alerta-uf
                data-fim={u.fimMax}
                class={`rounded-full border px-3 py-1.5 text-sm transition-colors hover:opacity-80 ${ALERTA_CHIP[u.pior.nivel] ?? ALERTA_CHIP[1]}`}
              >
                <strong>{u.uf.toUpperCase()}</strong> · {u.pior.evento}{u.total > 1 ? ` +${u.total - 1}` : ''}
              </a>
            ))}
          </div>
        </details>
        <p class="mt-2 text-xs text-muted-foreground">Avisos oficiais do INMET · clique na UF para detalhes</p>
      </section>
    )}

    <!-- Capitais agora: snapshot do build, hidratado ao vivo por agora-cliente.ts -->
    <section aria-label="Capitais agora">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Capitais agora</h2>
        <div class="flex items-center gap-3 text-xs">
          <button
            id="btn-ordenar-agora"
            type="button"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            ordem: alfabética ▾
          </button>
          <button
            id="btn-comparar-agora"
            type="button"
            class="text-primary hover:underline"
          >
            comparar
          </button>
        </div>
      </div>
      <div
        id="comparar-barra"
        class="mb-2 hidden items-baseline gap-x-2 rounded-lg border border-primary/40 bg-primary/5 px-3 py-2 text-xs"
        aria-live="polite"
      ></div>
      <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-5" id="grid-capitais">
        {capitais.map((c) => (
          <a
            href={`/${c.uf}/${c.slug}`}
            data-agora
            data-lat={c.latitude}
            data-lon={c.longitude}
            class="group rounded-lg border border-border bg-card px-3 py-2.5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
          >
            <p class="truncate text-xs font-medium text-foreground/80">{c.nome}</p>
            <p
              data-agora-temp
              class={`mt-1 text-xl font-bold tabular-nums leading-none ${c.temperatura != null ? corTemperaturaTexto(c.temperatura) : ''}`}
              title={c.temperatura != null ? catTemperatura(c.temperatura) : undefined}
            >
              {c.temperatura != null ? `${Math.round(c.temperatura)}°` : '—'}
            </p>
            <p class="mt-1">
              <span
                data-agora-aqi
                hidden={c.aqi == null}
                class={`text-xs font-semibold tabular-nums ${c.aqi != null ? corAqiTexto(c.aqi) : ''}`}
                title={c.aqi != null ? `Qualidade do ar: ${c.aqiCategoria ?? ''}` : undefined}
              >
                {c.aqi != null ? `AQI ${c.aqi}` : ''}
              </span>
            </p>
          </a>
        ))}
      </div>
      <p data-agora-selo class="mt-2 text-xs text-muted-foreground">
        Último levantamento; a temperatura e o ar são atualizados ao abrir a página.
      </p>
    </section>

    <!-- Destaques nacionais -->
    <section aria-label="Destaques nacionais">
      <div class="mb-3 flex items-baseline justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Brasil agora</h2>
        <a href="/rankings" class="text-sm text-primary hover:underline">Rankings completos →</a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {reservatoriosBaixos.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-4">
            <h3 class="mb-2 text-sm font-semibold text-foreground"><span aria-hidden="true">🌊</span> Reservatórios em atenção</h3>
            <ul class="space-y-1.5">
              {reservatoriosBaixos.map((c) => (
                <li>
                  <a href={`/${c.uf}/${c.slug}`} class="flex items-center justify-between gap-2 text-sm hover:text-primary transition-colors">
                    <span class="truncate text-foreground/80">{c.nome}/{c.uf.toUpperCase()}</span>
                    <span class={`shrink-0 font-semibold tabular-nums ${corReservatorioTexto(c.reservatorioPct!)}`}>{c.reservatorioPct!.toFixed(1)}%</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {maisFocos.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-4">
            <h3 class="mb-2 text-sm font-semibold text-foreground"><span aria-hidden="true">🔥</span> Mais focos de queimada</h3>
            <ul class="space-y-1.5">
              {maisFocos.map((c) => (
                <li>
                  <a href={`/${c.uf}/${c.slug}`} class="flex items-center justify-between gap-2 text-sm hover:text-primary transition-colors">
                    <span class="truncate text-foreground/80">{c.nome}/{c.uf.toUpperCase()}</span>
                    <span class={`shrink-0 font-semibold tabular-nums ${corFocosTexto(c.focos!)}`}>{c.focos} focos</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {dengueAlerta.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-4">
            <h3 class="mb-2 text-sm font-semibold text-foreground"><span aria-hidden="true">🦟</span> Dengue em alerta</h3>
            <ul class="space-y-1.5">
              {dengueAlerta.map((c) => (
                <li>
                  <a href={`/${c.uf}/${c.slug}`} class="flex items-center justify-between gap-2 text-sm hover:text-primary transition-colors">
                    <span class="truncate text-foreground/80">{c.nome}/{c.uf.toUpperCase()}</span>
                    <span class={`shrink-0 font-semibold ${corDengueTexto(c.dengueNivel!)}`}>{c.dengueLabel ?? `Nível ${c.dengueNivel}`}</span>
                  </a>
                </li>
              ))}
            </ul>
            {totalDengueAlerta > 5 && (
              <p class="mt-2 text-xs text-muted-foreground">e mais {totalDengueAlerta - 5} municípios em alerta</p>
            )}
          </div>
        )}
      </div>
      <p class="mt-2 text-xs text-muted-foreground">Gerado em {geradoEm} · atualiza 2x ao dia</p>
    </section>

    <!-- Formas de acesso: a mesma cidade em vários formatos -->
    <section aria-labelledby="acesso" class="space-y-6">
      <div class="space-y-2">
        <p class="text-lg font-semibold text-primary">Todos os dados da cidade em vários formatos</p>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="acesso" class="max-w-3xl text-3xl font-extrabold tracking-tight text-foreground">Dados climáticos, previsão do tempo, queimadas, abastecimento e alertas</h2>
          <a href="/curl" class="text-sm text-primary hover:underline">Guia completo dos formatos →</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none lg:col-span-2">
          <h3 class="text-lg font-bold text-foreground">No terminal</h3>
          <p class="mt-1 text-sm text-muted-foreground">Painel em ANSI com ar, UV, represa, dengue e queimadas.</p>
          <pre data-copiar class="mt-4 whitespace-pre-wrap break-all rounded-xl bg-muted px-4 py-3 text-sm text-foreground"><code>$ curl climabr.app/sp/sao-paulo</code></pre>
        </article>
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none lg:col-span-2">
          <h3 class="text-lg font-bold text-foreground">Na barra do tmux, i3 ou polybar</h3>
          <p class="mt-1 text-sm text-muted-foreground">Uma linha só, pronta para prompt e status bar.</p>
          <pre data-copiar class="mt-4 whitespace-pre-wrap break-all rounded-xl bg-muted px-4 py-3 text-sm text-foreground"><code>$ curl 'climabr.app/sp/sao-paulo?format=1'</code></pre>
        </article>
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none">
          <h3 class="text-lg font-bold text-foreground">Prometheus</h3>
          <p class="mt-1 text-sm text-muted-foreground">Métricas para scraping e alertas no Grafana.</p>
          <pre class="mt-4 whitespace-pre-wrap break-all rounded-xl bg-muted px-3 py-2 text-xs text-foreground"><code>?format=prometheus</code></pre>
        </article>
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none">
          <h3 class="text-lg font-bold text-foreground">JSON cru</h3>
          <p class="mt-1 text-sm text-muted-foreground">Dado aberto por cidade, com filtro de campos.</p>
          <pre class="mt-4 whitespace-pre-wrap break-all rounded-xl bg-muted px-3 py-2 text-xs text-foreground"><code>/api/sp/sao-paulo.json</code></pre>
        </article>
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none">
          <h3 class="text-lg font-bold text-foreground">Card para compartilhar</h3>
          <p class="mt-1 text-sm text-muted-foreground">SVG e PNG para README, Discord e preview social.</p>
          <pre class="mt-4 whitespace-pre-wrap break-all rounded-xl bg-muted px-3 py-2 text-xs text-foreground"><code>/sp/sao-paulo.svg · .png</code></pre>
        </article>
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none">
          <h3 class="text-lg font-bold text-foreground">Para LLMs e notas</h3>
          <p class="mt-1 text-sm text-muted-foreground">Markdown com seções à escolha.</p>
          <pre class="mt-4 whitespace-pre-wrap break-all rounded-xl bg-muted px-3 py-2 text-xs text-foreground"><code>?format=md&amp;secoes=ar,uv</code></pre>
        </article>
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none sm:col-span-2">
          <h3 class="text-lg font-bold text-foreground">Modo Painel</h3>
          <p class="mt-1 text-sm text-muted-foreground">Tela cheia para TV e monitor, com o fundo mudando conforme o tempo.</p>
          <a href="/sp/sao-paulo/telao" class="mt-4 inline-flex rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:brightness-110 transition">Ver exemplo, São Paulo</a>
        </article>
        <article class="rounded-2xl border border-border bg-card/70 backdrop-blur-sm p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 motion-reduce:transition-none motion-reduce:transform-none sm:col-span-2">
          <h3 class="text-lg font-bold text-foreground">Modo Mobile</h3>
          <p class="mt-1 text-sm text-muted-foreground">Cartões grandes para o celular, instalável como app.</p>
          <a href="/mobile?c=sp/sao-paulo" class="mt-4 inline-flex rounded-full border border-input bg-card px-5 py-2.5 text-sm text-foreground hover:bg-accent transition-colors">Ver exemplo, São Paulo</a>
        </article>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted-foreground">
        <li>Sem cookies e sem rastreio de terceiros</li>
        <li>Fontes oficiais nomeadas em cada dado</li>
        <li>Código AGPL-3.0, dados CC-BY-4.0</li>
      </ul>
    </section>

    <section aria-labelledby="tela-cheia" class="space-y-8">
      <h2 id="tela-cheia" class="text-3xl font-extrabold tracking-tight text-foreground">O mesmo dado para tela cheia ou no celular</h2>
      <div class="grid items-start gap-6 lg:grid-cols-[2fr_1fr]">
        <figure>
          <a href="/sp/sao-paulo/telao" class="block overflow-hidden rounded-2xl border border-border"><img src="/exemplo-modo-painel.webp" width="1600" height="1000" loading="lazy" alt="Modo Painel de São Paulo: grade escura com previsão, ar, UV, vento, represa, queimadas, dengue, sol, lua e bandeira tarifária" class="h-auto w-full" /></a>
          <figcaption class="mt-2 text-sm text-muted-foreground">Modo Painel para TV e monitor. <a class="text-primary hover:underline" href="/sp/sao-paulo/telao">Abrir exemplo</a></figcaption>
        </figure>
        <figure>
          <a href="/mobile?c=sp/sao-paulo" class="mx-auto block max-w-[16rem] overflow-hidden rounded-2xl border border-border"><img src="/exemplo-modo-mobile.webp" width="520" height="1125" loading="lazy" alt="Modo Mobile de São Paulo: cartões escuros com previsão, ar, UV, vento, represa, queimadas, dengue, sol e lua" class="h-auto w-full" /></a>
          <figcaption class="mt-2 text-center text-sm text-muted-foreground">Modo Mobile. <a class="text-primary hover:underline" href="/mobile?c=sp/sao-paulo">Abrir exemplo</a></figcaption>
        </figure>
      </div>
    </section>

    <p class="text-center text-xs text-muted-foreground">
      Sua cidade fica salva localmente, sem conta e sem rastreamento.
    </p>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ClimaBR.app",
    "url": "https://climabr.app",
    "description": "Previsão do tempo e painel ambiental para todas as 5.571 cidades brasileiras: qualidade do ar, água, clima e alertas.",
    "inLanguage": "pt-BR",
    "publisher": {
      "@type": "Organization",
      "name": "ClimaBR.app",
      "url": "https://climabr.app",
      "logo": { "@type": "ImageObject", "url": "https://climabr.app/favicon.svg" },
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://climabr.app/?q={termo}" },
      "query-input": "required name=termo",
    },
  })} />
</PainelLayout>

<script>
  import { carregarIndice, maisProxima } from '../scripts/busca-cidades';
  import { hidratarAgora } from '../scripts/agora-cliente';
  import { ativarCopiar } from '../scripts/copiar';
  ativarCopiar();

  // Card da última cidade aberta: a home é estática, então o link só existe no cliente
  function mostrarMinhaCidade(r: { uf?: string; slug?: string; nome?: string } | undefined): void {
    const link = document.getElementById('minha-cidade');
    const nome = document.getElementById('minha-cidade-nome');
    if (!link || !nome || !r?.uf || !r?.slug || !r?.nome) return;
    link.setAttribute('href', `/${r.uf}/${r.slug}`);
    nome.textContent = `${r.nome}/${r.uf.toUpperCase()}`;
    link.classList.remove('hidden');
    link.classList.add('flex');
  }

  function lerRecentes(): { uf: string; slug: string; nome: string }[] {
    try {
      const bruto = JSON.parse(localStorage.getItem('climabr_recentes') ?? '[]');
      return Array.isArray(bruto) ? bruto : [];
    } catch {
      return [];
    }
  }

  // App instalado abre em /?app=1 (start_url): vai direto para a última cidade.
  // replace evita que o botão voltar caia de novo na home.
  function abrirUltimaCidadeSeApp(): void {
    if (new URLSearchParams(location.search).get('app') !== '1') return;
    const ultima = lerRecentes()[0];
    if (ultima?.uf && ultima?.slug) location.replace(`/${ultima.uf}/${ultima.slug}`);
  }

  // Chips de cidades visitadas recentemente (gravadas pela página de cidade)
  function renderizarRecentes(): void {
    const wrap = document.getElementById('recentes');
    const chips = document.getElementById('recentes-chips');
    if (!wrap || !chips) return;
    const recentes = lerRecentes();
    if (recentes.length === 0) return;
    mostrarMinhaCidade(recentes[0]);
    chips.innerHTML = '';
    for (const r of recentes.slice(0, 5)) {
      if (!r?.uf || !r?.slug || !r?.nome) continue;
      const a = document.createElement('a');
      a.href = `/${r.uf}/${r.slug}`;
      a.className = 'rounded-full border border-input bg-card px-3 py-1.5 text-sm text-foreground/80 hover:bg-accent hover:text-foreground transition-colors';
      a.textContent = `${r.nome}/${r.uf.toUpperCase()}`;
      chips.appendChild(a);
    }
    wrap.classList.toggle('hidden', chips.children.length === 0);
  }

  // Placeholder com exemplos rotativos; para na primeira interação
  const EXEMPLOS = ['Cotia', 'Manaus', 'Pelotas', 'Petrolina', 'Sinop', 'Ilhéus'];
  let rotacao: ReturnType<typeof setInterval> | null = null;

  function initBuscaHome(): void {
    const input = document.getElementById('busca-home') as HTMLInputElement | null;
    if (!input || input.dataset.init) return;
    input.dataset.init = '1';

    // Autofoco só em telas largas (no celular abriria o teclado sem pedir)
    if (matchMedia('(min-width: 640px)').matches) input.focus();

    // Busca via URL (?q=cidade), usada pela SearchAction do JSON-LD
    const q = new URLSearchParams(location.search).get('q');
    if (q && !input.value) {
      input.value = q;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }

    let i = 0;
    if (rotacao) clearInterval(rotacao);
    rotacao = setInterval(() => {
      if (input.value || document.activeElement === input) return;
      i = (i + 1) % EXEMPLOS.length;
      input.placeholder = `Digite sua cidade... ex.: ${EXEMPLOS[i]}`;
    }, 3000);
  }

  // Home é estática (build 2x/dia): remove chips de alerta já vencidos
  function limparAlertasVencidos(): void {
    const secao = document.querySelector<HTMLElement>('[data-alertas-home]');
    if (!secao) return;
    secao.querySelectorAll<HTMLElement>('[data-alerta-uf]').forEach((el) => {
      const fim = el.dataset.fim;
      if (fim && Date.parse(fim) < Date.now()) el.remove();
    });
    // Sem JS a lista fica aberta; com JS, o celular começa recolhido
    const detalhes = secao.querySelector<HTMLDetailsElement>('[data-alertas-detalhes]');
    if (detalhes && !matchMedia('(min-width: 640px)').matches) detalhes.open = false;
    if (!secao.querySelector('[data-alerta-uf]')) secao.remove();
  }

  function initHome(): void {
    abrirUltimaCidadeSeApp();
    renderizarRecentes();
    initBuscaHome();
    limparAlertasVencidos();
    hidratarAgora();
  }

  initHome();
  document.addEventListener('astro:page-load', initHome);

  // Ordenar/comparar capitais: só reordena após a hidratação trazer data-temp.
  // Re-executa em cada navegação (ClientRouter recria o DOM); o dataset.init
  // evita achar listeners duplicados na primeira carga.
  function initAgoraFerramentas(): void {
    const grid = document.getElementById('grid-capitais');
    const btnOrdenar = document.getElementById('btn-ordenar-agora');
    const btnComparar = document.getElementById('btn-comparar-agora');
    const barra = document.getElementById('comparar-barra');
    if (!grid || !btnOrdenar || !btnComparar || !barra || grid.dataset.init) return;
    grid.dataset.init = '1';

    let ordenado = false;
    btnOrdenar.addEventListener('click', () => {
      aoTempo(grid, btnOrdenar, ordenado);
    });

    function aoTempo(caixa: HTMLElement, botao: HTMLElement, reverso: boolean): void {
      const itens = [...caixa.querySelectorAll<HTMLElement>('[data-agora]')];
      const prontos = itens.filter((i) => i.dataset.temp != null);
      if (prontos.length === 0) return;
      prontos.sort((a, b) =>
        reverso ? Number(a.dataset.temp) - Number(b.dataset.temp)
          : Number(b.dataset.temp) - Number(a.dataset.temp));
      prontos.forEach((i) => caixa.appendChild(i));
      botao.textContent = reverso ? 'ordem: alfabética ↺' : 'ordem: mais quente ↺';
      ordenado = !reverso;
    }

    // Comparar: modo seleção com chips; até 3 capitais na barra
    let comparando = false;
    const escolhidas: HTMLElement[] = [];
    const desenharBarra = (): void => {
      barra.textContent = '';
      const nomes: string[] = [];
      for (const el of escolhidas) {
        const nome = el.querySelector('p')?.textContent ?? '';
        nomes.push(`${nome} (${el.dataset.temp ?? '?'}°)`);
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.textContent = `${nome} ×`;
        chip.className = 'rounded-full border border-input bg-card px-2 py-0.5 shrink-0 hover:text-destructive';
        chip.addEventListener('click', () => {
          const i = escolhidas.indexOf(el);
          if (i >= 0) escolhidas.splice(i, 1);
          desenharBarra();
        });
        barra.appendChild(chip);
      }
      if (escolhidas.length >= 2) {
        const dica = document.createElement('span');
        dica.className = 'text-muted-foreground';
        dica.textContent = `diferença: ${(
          Math.max(...escolhidas.map((e) => Number(e.dataset.temp ?? 0))) -
          Math.min(...escolhidas.map((e) => Number(e.dataset.temp ?? 0)))
        ).toFixed(0)}°`;
        barra.appendChild(dica);
      }
      barra.classList.toggle('hidden', escolhidas.length === 0);
    };

    btnComparar.addEventListener('click', () => {
      comparando = !comparando;
      btnComparar.textContent = comparando ? 'cancelar comparação' : 'comparar';
      if (!comparando) {
        escolhidas.length = 0;
        desenharBarra();
      }
    });

    // No modo comparação, clique num cartão seleciona em vez de navegar
    grid.addEventListener('click', (e) => {
      if (e.defaultPrevented || !comparando) return;
      const cartao = (e.target instanceof Element)
        ? e.target.closest<HTMLElement>('[data-agora]')
        : null;
      if (!cartao) return;
      e.preventDefault();
      e.stopPropagation();
      const i = escolhidas.indexOf(cartao);
      if (i >= 0) escolhidas.splice(i, 1);
      else if (escolhidas.length < 3) escolhidas.push(cartao);
      desenharBarra();
    }, true);
  }
  initAgoraFerramentas();
  document.addEventListener('astro:page-load', initAgoraFerramentas);
  document.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('#btn-geo') : null;
    if (!btn) return;
    if (!('geolocation' in navigator)) {
      btn.textContent = 'Geolocalização indisponível neste navegador';
      btn.disabled = true;
      return;
    }
    btn.disabled = true;
    btn.textContent = '📍 Localizando…';
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        await carregarIndice();
        const cidade = maisProxima(pos.coords.latitude, pos.coords.longitude);
        if (cidade) {
          window.location.href = `/${cidade.uf}/${cidade.slug}`;
        } else {
          btn.textContent = 'Não foi possível localizar; use a busca';
          btn.disabled = false;
        }
      },
      () => {
        btn.textContent = 'Permissão negada; use a busca acima';
        btn.disabled = false;
      },
      { timeout: 10000, maximumAge: 300000 }
    );
  });
</script>
