---
import PainelLayout from '../../layouts/PainelLayout.astro';
import BlocoPrevisao from '../../components/BlocoPrevisao.astro';
import BlocoReservatorio from '../../components/BlocoReservatorio.astro';
import BlocoQueimadas from '../../components/BlocoQueimadas.astro';
import BlocoAr from '../../components/BlocoAr.astro';
import BlocoUV from '../../components/BlocoUV.astro';
import BlocoDengue from '../../components/BlocoDengue.astro';
import BlocoSol from '../../components/BlocoSol.astro';
import BlocoVento from '../../components/BlocoVento.astro';
import BlocoOndas from '../../components/BlocoOndas.astro';
import BlocoBandeira from '../../components/BlocoBandeira.astro';
import { descricaoTextual } from '../../lib/descricao';
import municipiosRaw from '../../../data/municipios.json';
import type { Municipio, DadosCidade } from '../../lib/types';

export async function getStaticPaths() {
  const municipios = municipiosRaw as Municipio[];
  return municipios.map((m) => ({
    params: { estado: m.estado, cidade: m.slug },
    props: { municipio: m },
  }));
}

interface Props {
  municipio: Municipio;
}

const { municipio } = Astro.props;
const { estado, cidade } = Astro.params;

let dados: DadosCidade | null = null;

try {
  const fs = await import('node:fs/promises');
  const path = await import('node:path');
  const filePath = path.join(process.cwd(), 'data', 'cidades', estado, `${cidade}.json`);
  const raw = await fs.readFile(filePath, 'utf-8');
  dados = JSON.parse(raw) as DadosCidade;
} catch {
  // Dados ainda não coletados
}

// Cidades mais próximas (haversine), para navegação e interlinking
function cidadesProximas(qtd = 6): { m: Municipio; km: number }[] {
  if (municipio.lat == null || municipio.lon == null) return [];
  const rad = (g: number) => (g * Math.PI) / 180;
  const lat1 = rad(municipio.lat);
  const melhores: { m: Municipio; km: number }[] = [];
  for (const m of municipiosRaw as Municipio[]) {
    if (m.id === municipio.id || m.lat == null || m.lon == null) continue;
    const dLat = rad(m.lat - municipio.lat!);
    const dLon = rad(m.lon - municipio.lon!);
    const a = Math.sin(dLat / 2) ** 2 +
      Math.cos(lat1) * Math.cos(rad(m.lat)) * Math.sin(dLon / 2) ** 2;
    const km = 12742 * Math.asin(Math.sqrt(a));
    if (melhores.length < qtd) {
      melhores.push({ m, km });
      melhores.sort((x, y) => x.km - y.km);
    } else if (km < melhores[qtd - 1].km) {
      melhores[qtd - 1] = { m, km };
      melhores.sort((x, y) => x.km - y.km);
    }
  }
  return melhores;
}
const vizinhas = cidadesProximas();

// Bandeira tarifária vigente (nacional), gerada por scripts/scrape-bandeira.py
let bandeira = null;
try {
  const fs = await import('node:fs/promises');
  const path = await import('node:path');
  bandeira = JSON.parse(
    await fs.readFile(path.join(process.cwd(), 'data', 'bandeira.json'), 'utf-8')
  );
} catch {
  // Arquivo ainda não gerado
}

// Avisos meteorológicos do INMET que atingem este município (por geocode)
interface AvisoCidade {
  evento: string;
  severidade: string;
  nivel: number;
  fim: string | null;
  geocodes: number[];
}

let avisosCidade: AvisoCidade[] = [];
try {
  const fs = await import('node:fs/promises');
  const path = await import('node:path');
  const raw = await fs.readFile(path.join(process.cwd(), 'data', 'alertas', `${municipio.estado}.json`), 'utf-8');
  const todos: AvisoCidade[] = JSON.parse(raw);
  const agoraTs = Date.now();
  avisosCidade = todos.filter(
    (a) => a.geocodes.includes(municipio.id) && (!a.fim || Date.parse(a.fim) > agoraTs)
  );
} catch {
  // Sem avisos ativos para a UF
}

// 1=Perigo Potencial, 2=Perigo, 3=Grande Perigo
const AVISO_CLS: Record<number, { card: string; texto: string }> = {
  1: { card: 'border-status-moderado/40 bg-status-moderado/10', texto: 'text-status-moderado' },
  2: { card: 'border-status-ruim/40 bg-status-ruim/10', texto: 'text-status-ruim' },
  3: { card: 'border-status-critico/40 bg-status-critico/10', texto: 'text-status-critico' },
};

const fmtVigencia = (iso: string | null): string =>
  iso
    ? new Date(iso).toLocaleString('pt-BR', {
        day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
        timeZone: 'America/Sao_Paulo',
      })
    : '';

// Monta description dinâmica com os dados disponíveis
function montarDescricao(): string {
  if (!dados) return `Previsão do tempo e painel ambiental de ${municipio.nome}, ${municipio.estado_nome}.`;
  const partes: string[] = [];
  const hoje = dados.previsao?.[0];
  if (hoje) partes.push(`${Math.round(hoje.min)}° a ${Math.round(hoje.max)}°, ${hoje.condicao}`);
  if (dados.qualidade_ar?.categoria) partes.push(`Ar: ${dados.qualidade_ar.categoria}`);
  if (dados.reservatorio?.nivel_pct != null) partes.push(`Reservatório: ${dados.reservatorio.nivel_pct}%`);
  if (dados.dengue?.nivel_label) partes.push(`Dengue: ${dados.dengue.nivel_label}`);
  if (dados.queimadas?.focos_100km != null) partes.push(`Queimadas: ${dados.queimadas.focos_100km} focos`);
  const base = `Previsão do tempo em ${municipio.nome}/${municipio.estado.toUpperCase()} hoje`;
  return partes.length ? `${base}: ${partes.join(', ')}.` : `${base} e painel ambiental completo.`;
}

const titulo = `Previsão do Tempo em ${municipio.nome} (${municipio.estado.toUpperCase()}): clima, qualidade do ar e alertas | ClimaBR`;
const descricao = montarDescricao();

function formatarDataHora(iso: string): string {
  return new Date(iso).toLocaleString('pt-BR', {
    day: '2-digit', month: '2-digit', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
    timeZone: 'America/Sao_Paulo',
  });
}

const temDados = dados && (
  dados.previsao?.length ||
  dados.qualidade_ar ||
  dados.uv ||
  dados.reservatorio ||
  dados.dengue ||
  dados.queimadas ||
  dados.sol
);
---

<PainelLayout
  title={titulo}
  description={descricao}
  cidade={municipio.nome}
  estado={municipio.estado}
  slug={municipio.slug}
>
  <nav class="mb-6 text-sm text-muted-foreground" aria-label="Navegação">
    <a href="/" class="hover:text-foreground/80">ClimaBR.app</a>
    <span class="mx-2">/</span>
    <a href={`/${municipio.estado}`} class="text-foreground/80 hover:text-primary">{municipio.estado.toUpperCase()}</a>
    <span class="mx-2">/</span>
    <span class="text-foreground">{municipio.nome}</span>
  </nav>

  <div
    class="mb-8"
    id="clima-root"
    data-lat={municipio.lat ?? ''}
    data-lon={municipio.lon ?? ''}
    data-uf={municipio.estado}
    data-slug={municipio.slug}
    data-nome={municipio.nome}
  >
    <div class="flex items-start justify-between gap-3">
      <h1 class="text-2xl font-bold text-foreground">
        {municipio.nome}
        <span class="text-muted-foreground text-lg">/{municipio.estado.toUpperCase()}</span>
      </h1>
      <button
        id="btn-compartilhar"
        aria-label="Compartilhar"
        title="Compartilhar"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-input bg-card px-3 py-1.5 text-sm text-foreground/80 hover:bg-accent hover:text-foreground transition-colors"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M13 4.5a2.5 2.5 0 1 1 .702 1.737L6.97 9.604a2.518 2.518 0 0 1 0 .792l6.733 3.367a2.5 2.5 0 1 1-.671 1.341l-6.733-3.367a2.5 2.5 0 1 1 0-3.475l6.733-3.366A2.52 2.52 0 0 1 13 4.5Z" />
        </svg>
        <span class="hidden sm:inline">Compartilhar</span>
      </button>
    </div>
    {dados?.temperatura_atual != null ? (
      <p id="clima-agora" class="mt-1 text-foreground/80 text-sm" aria-live="polite">{dados.temperatura_atual}°C agora</p>
    ) : municipio.lat != null && municipio.lon != null ? (
      <p id="clima-agora" class="mt-1 text-foreground/80 text-sm" aria-live="polite" data-skeleton>
        <span class="inline-block h-4 w-28 animate-pulse rounded bg-muted align-middle" aria-hidden="true"></span>
        <span class="sr-only">Carregando temperatura atual…</span>
      </p>
    ) : (
      <p id="clima-agora" class="mt-1 text-foreground/80 text-sm" aria-live="polite" hidden></p>
    )}
    {dados?.atualizado_em ? (
      <p
        id="clima-atualizado"
        class="mt-1 text-xs text-muted-foreground"
        data-ts={dados.atualizado_em}
        title={formatarDataHora(dados.atualizado_em)}
      >
        Atualizado em {formatarDataHora(dados.atualizado_em)}
      </p>
    ) : (
      <p id="clima-atualizado" class="mt-1 text-xs text-muted-foreground">Dados ainda não coletados para esta cidade.</p>
    )}

    <!-- Resumo textual (SEO + acessibilidade): prosa indexável antes dos blocos visuais.
         <details> mantém o texto no DOM mesmo fechado, então segue indexável;
         <summary> já expõe o estado expandido/recolhido para leitores de tela. -->
    <details class="group mt-4">
      <summary class="flex w-fit cursor-pointer list-none items-center gap-2 text-sm text-foreground/80 hover:text-primary [&::-webkit-details-marker]:hidden">
        <span aria-hidden="true">✨</span>
        <span class="font-medium">Resumo de hoje em {municipio.nome}</span>
        <svg class="h-4 w-4 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.23 8.27a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd" />
        </svg>
      </summary>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        {descricaoTextual(municipio, dados)}
        {avisosCidade.length > 0 && (
          <span data-alerta data-fim={avisosCidade[0].fim}>
            {' '}Atenção: a cidade está sob aviso de {avisosCidade[0].evento} ({avisosCidade[0].severidade}) do
            INMET até {fmtVigencia(avisosCidade[0].fim)}.
          </span>
        )}
      </p>
    </details>
  </div>

  {avisosCidade.length > 0 && (
    <div class="mb-6 space-y-2" data-alertas>
      {avisosCidade.map((a) => {
        const cls = AVISO_CLS[a.nivel] ?? AVISO_CLS[1];
        return (
          <div
            class={`flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-lg border px-4 py-3 text-sm ${cls.card}`}
            data-alerta
            data-fim={a.fim}
            role="status"
          >
            <span aria-hidden="true">⚠️</span>
            <strong class={`font-bold ${cls.texto}`}>{a.evento}</strong>
            <span class={`text-xs font-semibold uppercase tracking-wide ${cls.texto}`}>{a.severidade}</span>
            <span class="text-xs text-muted-foreground">aviso INMET até {fmtVigencia(a.fim)}</span>
            <a href={`/${municipio.estado}`} class="ml-auto text-xs text-primary hover:underline">
              ver detalhes e instruções
            </a>
          </div>
        );
      })}
    </div>
  )}

  {temDados ? (
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-6 items-start">
      <BlocoPrevisao previsao={dados!.previsao} />
      <BlocoAr
        qualidade_ar={dados!.qualidade_ar}
        umidade_pct={dados!.umidade_pct}
        pressao_hpa={dados!.pressao_hpa}
        ponto_orvalho_c={dados!.ponto_orvalho_c}
      />
      <BlocoUV uv={dados!.uv} />
      <BlocoReservatorio reservatorio={dados!.reservatorio} />
      <BlocoVento vento={dados!.vento} />
      <BlocoOndas ondas={dados!.ondas} />
      <BlocoQueimadas queimadas={dados!.queimadas} />
      <BlocoDengue
        dengue={dados!.dengue}
        chikungunya={dados!.chikungunya}
        zika={dados!.zika}
      />
      <BlocoSol sol={dados!.sol} lua={dados!.lua} />
      <BlocoBandeira bandeira={bandeira} />
    </div>
  ) : (
    <div class="rounded-lg border border-border bg-card p-8 text-center">
      <p class="text-muted-foreground">
        Os dados de <strong class="text-foreground">{municipio.nome}</strong> ainda estão sendo coletados.
      </p>
      <p class="mt-2 text-sm text-muted-foreground">
        As coletas acontecem automaticamente a cada 3-6 horas via GitHub Actions.
      </p>
      <div class="mt-4 flex justify-center gap-4 text-sm">
        <a href={`/api/${estado}/${cidade}.json`} class="text-primary hover:underline">
          Ver JSON
        </a>
        <a href="/" class="text-muted-foreground hover:text-foreground hover:underline">
          Voltar ao início
        </a>
      </div>
    </div>
  )}

  {vizinhas.length > 0 && (
    <section aria-label="Cidades próximas" class="mt-8">
      <h2 class="mb-3 flex items-center gap-2 text-base font-semibold text-foreground">
        <span aria-hidden="true">📍</span> Cidades próximas
      </h2>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {vizinhas.map(({ m, km }) => (
          <a href={`/${m.estado}/${m.slug}`} class="rounded-lg border border-border bg-card px-3 py-2 hover:bg-accent transition-colors">
            <p class="truncate text-sm text-foreground/80">
              {m.nome}{m.estado !== municipio.estado ? ` /${m.estado.toUpperCase()}` : ''}
            </p>
            <p class="text-xs text-muted-foreground tabular-nums">{Math.round(km)} km</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Dataset",
        "name": `Dados Ambientais — ${municipio.nome}/${municipio.estado.toUpperCase()}`,
        "description": descricao,
        "keywords": [
          "previsão do tempo", "qualidade do ar", "índice UV", "vento",
          "reservatório", "queimadas", "dengue", municipio.nome, municipio.estado_nome,
        ],
        "spatialCoverage": {
          "@type": "Place",
          "name": municipio.nome,
          "address": {
            "@type": "PostalAddress",
            "addressLocality": municipio.nome,
            "addressRegion": municipio.estado.toUpperCase(),
            "addressCountry": "BR",
          },
          ...(municipio.lat && municipio.lon ? {
            "geo": { "@type": "GeoCoordinates", "latitude": municipio.lat, "longitude": municipio.lon },
          } : {}),
        },
        "temporalCoverage": `${new Date().getFullYear()}/..`,
        "url": `https://climabr.app/${estado}/${cidade}`,
        "license": "https://creativecommons.org/licenses/by/4.0/",
        "creator": { "@type": "Organization", "name": "ClimaBR.app", "url": "https://climabr.app" },
        "distribution": {
          "@type": "DataDownload",
          "encodingFormat": "application/json",
          "contentUrl": `https://climabr.app/api/${estado}/${cidade}.json`,
        },
        ...(dados?.atualizado_em ? { "dateModified": dados.atualizado_em } : {}),
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "ClimaBR.app", "item": "https://climabr.app" },
          { "@type": "ListItem", "position": 2, "name": municipio.estado_nome, "item": `https://climabr.app/${municipio.estado}` },
          { "@type": "ListItem", "position": 3, "name": municipio.nome, "item": `https://climabr.app/${estado}/${cidade}` },
        ],
      },
    ],
  })} />

  <script>
    import { hidratarClima } from '../../scripts/previsao-cliente';
    import { salvarRecente } from '../../scripts/recentes';

    function initCidade(): void {
      const root = document.getElementById('clima-root');
      if (!root || root.dataset.init) return; // evita rodar 2x na carga inicial
      root.dataset.init = '1';
      salvarRecente();
      hidratarClima();
      limparAvisosVencidos();
    }

    // Página é estática (build 2x/dia): remove avisos já vencidos no cliente
    function limparAvisosVencidos(): void {
      document.querySelectorAll<HTMLElement>('[data-alerta]').forEach((el) => {
        const fim = el.dataset.fim;
        if (fim && Date.parse(fim) < Date.now()) el.remove();
      });
      const banner = document.querySelector<HTMLElement>('[data-alertas]');
      if (banner && !banner.querySelector('[data-alerta]')) banner.remove();
    }

    initCidade();
    // Re-executa ao navegar entre cidades via ClientRouter
    document.addEventListener('astro:page-load', initCidade);

    // Compartilhar: Web Share API com fallback de copiar o link
    document.addEventListener('click', async (e) => {
      const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('#btn-compartilhar') : null;
      if (!btn) return;
      const compartilhavel = { title: document.title, url: window.location.href };
      if (navigator.share) {
        try { await navigator.share(compartilhavel); } catch { /* usuário cancelou */ }
        return;
      }
      try {
        await navigator.clipboard.writeText(window.location.href);
        // Feedback substitui ícone+rótulo e restaura depois (rótulo some no mobile)
        const original = btn.innerHTML;
        btn.textContent = 'Link copiado!';
        setTimeout(() => { btn.innerHTML = original; }, 2000);
      } catch { /* clipboard indisponível */ }
    });
  </script>
</PainelLayout>
