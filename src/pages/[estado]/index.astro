---
import PainelLayout from '../../layouts/PainelLayout.astro';
import municipiosRaw from '../../../data/municipios.json';
import type { Municipio } from '../../lib/types';

export async function getStaticPaths() {
  const municipios = municipiosRaw as Municipio[];
  const estados = [...new Set(municipios.map((m) => m.estado))];
  return estados.map((uf) => ({
    params: { estado: uf },
    props: {
      uf,
      nome: municipios.find((m) => m.estado === uf)!.estado_nome,
      cidades: municipios
        .filter((m) => m.estado === uf)
        .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR')),
    },
  }));
}

interface Props {
  uf: string;
  nome: string;
  cidades: Municipio[];
}

const { uf, nome, cidades } = Astro.props;

const titulo = `${nome} (${uf.toUpperCase()}) — ${cidades.length} municípios — ClimaBR.app`;
const descricao = `Dados ambientais dos ${cidades.length} municípios de ${nome}: previsão do tempo, ` +
  `qualidade do ar, índice UV, vento, reservatórios, queimadas e alertas de dengue por cidade.`;

// Agrupa por letra inicial para navegação
const porLetra = cidades.reduce<Record<string, Municipio[]>>((acc, c) => {
  const letra = c.nome[0].toUpperCase();
  (acc[letra] ??= []).push(c);
  return acc;
}, {});
const letras = Object.keys(porLetra).sort((a, b) => a.localeCompare(b, 'pt-BR'));

// Nome sem acentos/minúsculo pré-computado para o filtro client-side
const normalizar = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
---

<PainelLayout title={titulo} description={descricao}>
  <nav class="mb-6 text-sm text-muted-foreground" aria-label="Navegação">
    <a href="/" class="hover:text-foreground/80">ClimaBR.app</a>
    <span class="mx-2">/</span>
    <span class="text-foreground">{nome}</span>
  </nav>

  <div class="mb-8">
    <h1 class="text-2xl font-bold text-foreground">
      {nome}
      <span class="text-muted-foreground text-lg">/{uf.toUpperCase()}</span>
    </h1>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      Dados ambientais dos <strong class="text-foreground">{cidades.length}</strong> municípios
      de {nome}. Selecione uma cidade para ver previsão do tempo, qualidade do ar, índice UV,
      vento, nível de reservatórios, focos de queimada e alertas de dengue.
    </p>
  </div>

  <label for="filtro-municipios" class="sr-only">Filtrar municípios</label>
  <input
    id="filtro-municipios"
    type="search"
    placeholder={`Filtrar ${cidades.length} municípios...`}
    autocomplete="off"
    class="mb-6 w-full rounded-md border border-input bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
  />

  {letras.map((letra) => (
    <section class="mb-6" data-letra>
      <h2 class="sticky top-14 z-10 mb-2 bg-background/95 backdrop-blur py-1 text-sm font-bold text-primary">{letra}</h2>
      <div class="grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">
        {porLetra[letra].map((c) => (
          <a
            href={`/${c.estado}/${c.slug}`}
            data-nome={normalizar(c.nome)}
            class="truncate py-1 text-sm text-foreground/80 hover:text-primary transition-colors"
          >
            {c.nome}
          </a>
        ))}
      </div>
    </section>
  ))}

  <p id="filtro-vazio" class="hidden text-sm text-muted-foreground">Nenhum município corresponde ao filtro.</p>

  <script>
    // Filtro da lista: esconde links e seções sem correspondência
    const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

    function initFiltro(): void {
      const input = document.getElementById('filtro-municipios') as HTMLInputElement | null;
      if (!input || input.dataset.init) return;
      input.dataset.init = '1';
      input.addEventListener('input', () => {
        const termo = norm(input.value.trim());
        let total = 0;
        document.querySelectorAll<HTMLElement>('[data-letra]').forEach((sec) => {
          let visiveis = 0;
          sec.querySelectorAll<HTMLElement>('a[data-nome]').forEach((a) => {
            const mostra = !termo || (a.dataset.nome ?? '').includes(termo);
            a.style.display = mostra ? '' : 'none';
            if (mostra) visiveis++;
          });
          sec.style.display = visiveis ? '' : 'none';
          total += visiveis;
        });
        document.getElementById('filtro-vazio')?.classList.toggle('hidden', total > 0);
      });
    }

    initFiltro();
    document.addEventListener('astro:page-load', initFiltro);
  </script>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `Municípios de ${nome}`,
    "description": descricao,
    "url": `https://climabr.app/${uf}`,
    "isPartOf": { "@type": "WebSite", "name": "ClimaBR.app", "url": "https://climabr.app" },
    "about": { "@type": "Place", "name": nome, "addressRegion": uf.toUpperCase(), "addressCountry": "BR" },
  })} />
</PainelLayout>
