---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import PainelLayout from '../../layouts/PainelLayout.astro';
import municipiosRaw from '../../../data/municipios.json';
import type { Municipio } from '../../lib/types';

interface Aviso {
  id: number;
  evento: string;
  severidade: string;
  nivel: number;
  cor: string;
  inicio: string | null;
  fim: string | null;
  riscos: string[];
  instrucoes: string[];
  geocodes: number[];
}

export async function getStaticPaths() {
  const municipios = municipiosRaw as Municipio[];
  const estados = [...new Set(municipios.map((m) => m.estado))];
  return estados.map((uf) => ({
    params: { estado: uf },
    props: {
      uf,
      nome: municipios.find((m) => m.estado === uf)!.estado_nome,
      cidades: municipios
        .filter((m) => m.estado === uf)
        .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR')),
    },
  }));
}

interface Props {
  uf: string;
  nome: string;
  cidades: Municipio[];
}

const { uf, nome, cidades } = Astro.props;

const titulo = `${nome} (${uf.toUpperCase()}) — ${cidades.length} municípios — ClimaBR.app`;
const descricao = `Dados ambientais dos ${cidades.length} municípios de ${nome}: previsão do tempo, ` +
  `qualidade do ar, índice UV, vento, reservatórios, queimadas e alertas de dengue por cidade.`;

// Avisos meteorológicos ativos (INMET), gerados por scripts/scrape-alertas.py
let avisos: Aviso[] = [];
try {
  const raw = await readFile(path.join(process.cwd(), 'data', 'alertas', `${uf}.json`), 'utf-8');
  avisos = JSON.parse(raw);
} catch {
  // Sem avisos ativos ou arquivo ainda não gerado
}
const agoraTs = Date.now();
avisos = avisos.filter((a) => !a.fim || Date.parse(a.fim) > agoraTs);

const porGeocode = new Map(cidades.map((c) => [c.id, c]));
const cidadesDoAviso = (a: Aviso): Municipio[] =>
  a.geocodes.map((g) => porGeocode.get(g)).filter((c): c is Municipio => Boolean(c));

// 1=Perigo Potencial, 2=Perigo, 3=Grande Perigo
const AVISO_CLS: Record<number, { card: string; texto: string }> = {
  1: { card: 'border-status-moderado/40 bg-status-moderado/10', texto: 'text-status-moderado' },
  2: { card: 'border-status-ruim/40 bg-status-ruim/10', texto: 'text-status-ruim' },
  3: { card: 'border-status-critico/40 bg-status-critico/10', texto: 'text-status-critico' },
};

const fmtVigencia = (iso: string | null): string =>
  iso
    ? new Date(iso).toLocaleString('pt-BR', {
        day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
        timeZone: 'America/Sao_Paulo',
      })
    : '';

// Agrupa por letra inicial para navegação
const porLetra = cidades.reduce<Record<string, Municipio[]>>((acc, c) => {
  const letra = c.nome[0].toUpperCase();
  (acc[letra] ??= []).push(c);
  return acc;
}, {});
const letras = Object.keys(porLetra).sort((a, b) => a.localeCompare(b, 'pt-BR'));

// Nome sem acentos/minúsculo pré-computado para o filtro client-side
const normalizar = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
---

<PainelLayout title={titulo} description={descricao}>
  <nav class="mb-6 text-sm text-muted-foreground" aria-label="Navegação">
    <a href="/" class="hover:text-foreground/80">ClimaBR.app</a>
    <span class="mx-2">/</span>
    <span class="text-foreground">{nome}</span>
  </nav>

  <div class="mb-8">
    <h1 class="text-2xl font-bold text-foreground">
      {nome}
      <span class="text-muted-foreground text-lg">/{uf.toUpperCase()}</span>
    </h1>
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      Dados ambientais dos <strong class="text-foreground">{cidades.length}</strong> municípios
      de {nome}. Selecione uma cidade para ver previsão do tempo, qualidade do ar, índice UV,
      vento, nível de reservatórios, focos de queimada e alertas de dengue.
    </p>
  </div>

  {avisos.length > 0 && (
    <section aria-label="Alertas meteorológicos" class="mb-8" data-alertas>
      <h2 class="mb-3 text-base font-semibold text-foreground">
        <span aria-hidden="true">⚠️</span> Alertas meteorológicos ativos
      </h2>
      <div class="space-y-3">
        {avisos.map((a) => {
          const cls = AVISO_CLS[a.nivel] ?? AVISO_CLS[1];
          const afetadas = cidadesDoAviso(a);
          return (
            <details class={`rounded-lg border ${cls.card}`} data-alerta data-fim={a.fim}>
              <summary class="cursor-pointer list-none p-4 [&::-webkit-details-marker]:hidden">
                <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <strong class={`text-sm font-bold ${cls.texto}`}>{a.evento}</strong>
                  <span class={`text-xs font-semibold uppercase tracking-wide ${cls.texto}`}>{a.severidade}</span>
                  <span class="text-xs text-muted-foreground">até {fmtVigencia(a.fim)}</span>
                  <span class="text-xs text-muted-foreground">
                    {afetadas.length === cidades.length
                      ? 'todo o estado'
                      : `${afetadas.length} de ${cidades.length} municípios`}
                  </span>
                  <span class="ml-auto text-xs text-muted-foreground">detalhes ▾</span>
                </span>
              </summary>
              <div class="space-y-3 px-4 pb-4 text-sm text-foreground/80">
                {a.riscos.length > 0 && <p>{a.riscos.join(' ')}</p>}
                {a.instrucoes.length > 0 && (
                  <ul class="list-disc space-y-0.5 pl-5 text-foreground/70">
                    {a.instrucoes.map((inst) => <li>{inst.trim()}</li>)}
                  </ul>
                )}
                {afetadas.length < cidades.length && (
                  <details class="pt-1">
                    <summary class="cursor-pointer text-xs text-muted-foreground hover:text-foreground/80">
                      Ver municípios afetados
                    </summary>
                    <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">
                      {afetadas.map((c) => (
                        <a href={`/${c.estado}/${c.slug}`} class="truncate text-xs text-foreground/70 hover:text-primary transition-colors">
                          {c.nome}
                        </a>
                      ))}
                    </div>
                  </details>
                )}
                <p class="text-xs text-muted-foreground">Fonte: INMET · avisos oficiais Alert-AS</p>
              </div>
            </details>
          );
        })}
      </div>
    </section>
  )}

  <label for="filtro-municipios" class="sr-only">Filtrar municípios</label>
  <input
    id="filtro-municipios"
    type="search"
    placeholder={`Filtrar ${cidades.length} municípios...`}
    autocomplete="off"
    class="mb-6 w-full rounded-md border border-input bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
  />

  {letras.map((letra) => (
    <section class="mb-6" data-letra>
      <h2 class="sticky top-14 z-10 mb-2 bg-background/95 backdrop-blur py-1 text-sm font-bold text-primary">{letra}</h2>
      <div class="grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">
        {porLetra[letra].map((c) => (
          <a
            href={`/${c.estado}/${c.slug}`}
            data-nome={normalizar(c.nome)}
            class="truncate py-1 text-sm text-foreground/80 hover:text-primary transition-colors"
          >
            {c.nome}
          </a>
        ))}
      </div>
    </section>
  ))}

  <p id="filtro-vazio" class="hidden text-sm text-muted-foreground">Nenhum município corresponde ao filtro.</p>

  <script>
    // Filtro da lista: esconde links e seções sem correspondência
    const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

    function initFiltro(): void {
      const input = document.getElementById('filtro-municipios') as HTMLInputElement | null;
      if (!input || input.dataset.init) return;
      input.dataset.init = '1';
      input.addEventListener('input', () => {
        const termo = norm(input.value.trim());
        let total = 0;
        document.querySelectorAll<HTMLElement>('[data-letra]').forEach((sec) => {
          let visiveis = 0;
          sec.querySelectorAll<HTMLElement>('a[data-nome]').forEach((a) => {
            const mostra = !termo || (a.dataset.nome ?? '').includes(termo);
            a.style.display = mostra ? '' : 'none';
            if (mostra) visiveis++;
          });
          sec.style.display = visiveis ? '' : 'none';
          total += visiveis;
        });
        document.getElementById('filtro-vazio')?.classList.toggle('hidden', total > 0);
      });
    }

    // Página é estática (build 2x/dia): remove avisos já vencidos no cliente
    function limparAvisosVencidos(): void {
      const secao = document.querySelector<HTMLElement>('[data-alertas]');
      if (!secao) return;
      secao.querySelectorAll<HTMLElement>('[data-alerta]').forEach((el) => {
        const fim = el.dataset.fim;
        if (fim && Date.parse(fim) < Date.now()) el.remove();
      });
      if (!secao.querySelector('[data-alerta]')) secao.remove();
    }

    initFiltro();
    limparAvisosVencidos();
    document.addEventListener('astro:page-load', () => {
      initFiltro();
      limparAvisosVencidos();
    });
  </script>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `Municípios de ${nome}`,
    "description": descricao,
    "url": `https://climabr.app/${uf}`,
    "isPartOf": { "@type": "WebSite", "name": "ClimaBR.app", "url": "https://climabr.app" },
    "about": { "@type": "Place", "name": nome, "addressRegion": uf.toUpperCase(), "addressCountry": "BR" },
  })} />
</PainelLayout>
