---
import type { DadosCidade } from '../lib/types';

interface Props {
  chuva: DadosCidade['chuva_estacoes'];
}
const { chuva } = Astro.props;

// Faixas de intensidade do próprio Alerta Rio, em mm por hora. Manter a escala
// da fonte importa: é a mesma que a prefeitura usa nos boletins, então o rótulo
// aqui bate com o que o carioca ouve no rádio.
const FAIXAS = [
  { ate: 0.2, rotulo: 'Sem chuva', classe: 'text-status-bom' },
  { ate: 5, rotulo: 'Chuva fraca', classe: 'text-status-bom' },
  { ate: 25, rotulo: 'Chuva moderada', classe: 'text-status-moderado' },
  { ate: 50, rotulo: 'Chuva forte', classe: 'text-status-ruim' },
  { ate: Infinity, rotulo: 'Chuva muito forte', classe: 'text-status-pessimo' },
];
const faixa = (mm: number) => FAIXAS.find((f) => mm < f.ate) ?? FAIXAS[FAIXAS.length - 1];

const atual = faixa(chuva?.max_h01 ?? 0);
const chovendo = (chuva?.chovendo ?? 0) > 0;

// Chovendo, o que importa é onde e quanto agora; seco, o acumulado recente é o
// que ainda diz alguma coisa (encosta encharcada de chuva de ontem). Listar as
// 33 estações sempre viraria uma tabela sem leitura.
const MAX_LISTA = 8;
const comChuva = (chuva?.estacoes ?? []).filter((e) => (chovendo ? e.h01 > 0 : e.h24 > 0));
const lista = (comChuva.length > 0 ? comChuva : (chuva?.estacoes ?? []))
  .slice(0, MAX_LISTA);
const ocultas = (comChuva.length > 0 ? comChuva.length : (chuva?.total ?? 0)) - lista.length;

const hora = (iso: string | null): string =>
  iso
    ? new Date(iso).toLocaleTimeString('pt-BR', {
        hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo',
      })
    : '';

const mm = (v: number) => `${v.toFixed(1).replace('.', ',')} mm`;
---

{chuva && chuva.total > 0 && (
  <section aria-label="Chuva por bairro" class="sm:col-span-2">
    <h2 class="mb-3 flex items-center gap-2 text-base font-semibold text-foreground">
      <span aria-hidden="true">🌧</span> Chuva por bairro
    </h2>
    <div class="rounded-lg border border-border bg-card p-4">
      <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
        <div>
          <p class={`text-3xl font-bold ${atual.classe}`}>
            {chovendo ? atual.rotulo : 'Sem chuva agora'}
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            {chovendo
              ? `${mm(chuva.max_h01)} na última hora em ${chuva.max_h01_estacao}`
              : chuva.com_chuva_24h > 0
                ? `Máxima de ${mm(chuva.max_h24)} em 24 h, em ${chuva.max_h24_estacao}`
                : 'Nenhuma das estações registrou chuva nas últimas 24 horas'}
          </p>
        </div>
        <p class="text-right text-xs text-muted-foreground">
          <span class="font-semibold tabular-nums text-foreground/80">{chuva.total}</span> estações
          {chuva.chovendo > 0 && (
            <span> · <span class="font-semibold tabular-nums text-status-info">{chuva.chovendo}</span> com chuva</span>
          )}
        </p>
      </div>

      {lista.length > 0 && (
        <ul class="mt-3 space-y-1.5 border-t border-border pt-3">
          {lista.map((e) => (
            <li class="flex items-baseline gap-3 text-xs">
              <span class="min-w-0 flex-1 truncate text-foreground/80">{e.nome}</span>
              {!e.recente && (
                <span class="shrink-0 text-muted-foreground" title={`Última leitura às ${hora(e.lido_em)}`}>sem leitura recente</span>
              )}
              <span class="w-24 shrink-0 text-right tabular-nums text-muted-foreground">
                {mm(e.h01)}<span class="text-[0.65rem]"> /1h</span>
              </span>
              <span class="w-24 shrink-0 text-right font-semibold tabular-nums text-foreground/80">
                {mm(e.h24)}<span class="text-[0.65rem] font-normal text-muted-foreground"> /24h</span>
              </span>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-3 border-t border-border pt-3 text-xs leading-relaxed text-muted-foreground">
        {ocultas > 0 && <span>Mais {ocultas} {ocultas === 1 ? 'estação' : 'estações'}. </span>}
        Fonte: <a href={chuva.url} rel="noopener external" class="text-primary hover:underline">{chuva.fonte}</a>.
        As faixas de intensidade são as do próprio Alerta Rio. Leitura do último build do site;
        em chuva forte, confira a fonte ao vivo.
      </p>
    </div>
  </section>
)}
