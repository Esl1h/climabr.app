---
import type { DadosCidade } from '../lib/types';

interface Props {
  agua: DadosCidade['agua'];
}
const { agua } = Astro.props;

function corConformidade(pct: number): string {
  if (pct >= 99.5) return 'text-status-bom';
  if (pct >= 98) return 'text-status-moderado';
  if (pct >= 95) return 'text-status-ruim';
  return 'text-status-pessimo';
}
---

{agua && agua.pct_conformes != null && agua.amostras > 0 && (
  <section aria-label="Qualidade da água">
    <h2 class="mb-3 flex items-center gap-2 text-base font-semibold text-foreground">
      <span aria-hidden="true">💧</span> Qualidade da água
    </h2>
    <div class="rounded-lg border border-border bg-card p-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class={`text-3xl font-bold tabular-nums ${corConformidade(agua.pct_conformes)}`}>
            {agua.pct_conformes.toFixed(1).replace('.', ',')}%
          </p>
          <p class="mt-1 text-sm text-muted-foreground">amostras sem E. coli em {agua.periodo}</p>
        </div>
        <div class="text-right text-xs text-muted-foreground">
          <p>
            <span class="font-semibold tabular-nums text-foreground/80">{agua.com_presenca}</span> de{' '}
            <span class="tabular-nums">{agua.amostras}</span> amostras com presença
          </p>
          <p class="mt-1">Fonte: {agua.fonte}</p>
        </div>
      </div>
      <p class="mt-3 border-t border-border pt-3 text-xs text-muted-foreground">
        Vigilância em todas as formas de abastecimento (rede, poços e soluções alternativas);
        o padrão de potabilidade exige ausência de E. coli.
      </p>
    </div>
  </section>
)}
