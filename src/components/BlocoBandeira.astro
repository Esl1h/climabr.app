---
interface Props {
  bandeira: {
    bandeira: string;
    competencia: string;
    adicional_por_100kwh: number;
    fonte: string;
  } | null;
}
const { bandeira } = Astro.props;

// Aparência por bandeira acionada (ANEEL)
const ESTILO: Record<string, { ponto: string; texto: string }> = {
  'Verde': { ponto: 'bg-status-bom', texto: 'text-status-bom' },
  'Amarela': { ponto: 'bg-status-moderado', texto: 'text-status-moderado' },
  'Vermelha - Patamar 1': { ponto: 'bg-status-ruim', texto: 'text-status-ruim' },
  'Vermelha - Patamar 2': { ponto: 'bg-status-pessimo', texto: 'text-status-pessimo' },
  'Escassez Hídrica': { ponto: 'bg-status-critico', texto: 'text-status-critico' },
};
const estilo = bandeira ? (ESTILO[bandeira.bandeira] ?? ESTILO['Amarela']) : null;

const [ano, mes] = (bandeira?.competencia ?? '').split('-');
const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho',
  'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
const mesNome = mes ? MESES[parseInt(mes, 10) - 1] : '';
---

{bandeira && estilo && (
  <section aria-label="Bandeira tarifária de energia">
    <h2 class="mb-3 flex items-center gap-2 text-base font-semibold text-foreground">
      <span aria-hidden="true">💡</span> Bandeira tarifária
    </h2>
    <div class="rounded-lg border border-border bg-card p-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class={`flex items-center gap-2 text-xl font-bold ${estilo.texto}`}>
            <span class={`inline-block h-3 w-3 rounded-full ${estilo.ponto}`} aria-hidden="true"></span>
            {bandeira.bandeira}
          </p>
          <p class="mt-1 text-xs text-muted-foreground">{mesNome} de {ano} · vale para todo o Brasil</p>
        </div>
        <div class="text-right">
          {bandeira.adicional_por_100kwh > 0 ? (
            <p class="text-sm text-foreground/80">
              +<span class="font-semibold tabular-nums">R$ {bandeira.adicional_por_100kwh.toFixed(2).replace('.', ',')}</span>
              <span class="block text-xs text-muted-foreground">a cada 100 kWh</span>
            </p>
          ) : (
            <p class="text-sm text-status-bom">sem custo extra</p>
          )}
          <p class="mt-1 text-xs text-muted-foreground">Fonte: {bandeira.fonte}</p>
        </div>
      </div>
    </div>
  </section>
)}
