---
import type { DadosCidade } from '../lib/types';

interface Props {
  reservatorio: DadosCidade['reservatorio'];
}
const { reservatorio } = Astro.props;

function corNivel(pct: number): string {
  if (pct >= 70) return 'text-status-bom';
  if (pct >= 40) return 'text-status-moderado';
  return 'text-status-pessimo';
}

const aproximado = reservatorio?.aproximado ?? false;
const titulo = aproximado ? 'Reservatório próximo' : 'Reservatório';
---

{reservatorio && reservatorio.nivel_pct !== null && reservatorio.nivel_pct !== undefined && (
  <section aria-label="Nível do reservatório">
    <h2 class="mb-3 flex items-center gap-2 text-base font-semibold text-foreground">
      <span aria-hidden="true">🌊</span> {titulo}
    </h2>
    <div class={`rounded-lg border bg-card p-4 ${aproximado ? 'border-muted-foreground/40' : 'border-border'}`}>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-muted-foreground">{reservatorio.nome}</p>
          <p class={`text-3xl font-bold ${corNivel(reservatorio.nivel_pct)}`}>
            {reservatorio.nivel_pct.toFixed(1)}%
          </p>
          {reservatorio.distancia_km && (
            <p class="text-xs text-muted-foreground">{reservatorio.distancia_km}km de distância</p>
          )}
        </div>
        <div class="text-right">
          {reservatorio.variacao_semana_pct != null && (
            reservatorio.variacao_semana_pct > 0 ? (
              <span class="text-sm text-status-bom">+{reservatorio.variacao_semana_pct.toFixed(1)}% semana</span>
            ) : reservatorio.variacao_semana_pct < 0 ? (
              <span class="text-sm text-status-pessimo">{reservatorio.variacao_semana_pct.toFixed(1)}% semana</span>
            ) : (
              <span class="text-sm text-muted-foreground">estável</span>
            )
          )}
          <p class="mt-1 text-xs text-muted-foreground">Fonte: {reservatorio.fonte}</p>
        </div>
      </div>

      <!-- Barra de progresso -->
      <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-muted">
        <div
          class={`h-full rounded-full transition-all ${
            reservatorio.nivel_pct >= 70
              ? 'bg-status-bom'
              : reservatorio.nivel_pct >= 40
              ? 'bg-status-moderado'
              : 'bg-status-pessimo'
          }`}
          style={`width: ${Math.min(100, reservatorio.nivel_pct)}%`}
          role="progressbar"
          aria-label="Nível do reservatório"
          aria-valuenow={reservatorio.nivel_pct}
          aria-valuemin={0}
          aria-valuemax={100}
        />
      </div>

      <!-- Aviso para dados aproximados -->
      {aproximado && (
        <p class="mt-3 text-xs text-muted-foreground border-t border-border pt-3">
          <span class="text-status-moderado">⚠</span> {reservatorio.nota}
        </p>
      )}
    </div>
  </section>
)}
