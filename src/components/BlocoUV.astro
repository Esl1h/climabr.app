---
import type { DadosCidade } from '../lib/types';

interface Props {
  uv: DadosCidade['uv'];
}
const { uv } = Astro.props;

function corUV(indice: number): string {
  if (indice < 3) return 'text-status-bom';
  if (indice < 6) return 'text-status-moderado';
  if (indice < 8) return 'text-status-ruim';
  if (indice < 11) return 'text-status-pessimo';
  return 'text-status-extremo';
}

function barraUV(indice: number): string {
  if (indice < 3) return 'bg-status-bom dark:bg-status-bom/80';
  if (indice < 6) return 'bg-status-moderado dark:bg-status-moderado/80';
  if (indice < 8) return 'bg-status-ruim dark:bg-status-ruim/80';
  if (indice < 11) return 'bg-status-pessimo dark:bg-status-pessimo/80';
  return 'bg-status-extremo dark:bg-status-extremo/80';
}

const pct = uv ? Math.min(100, Math.round((uv.indice / 12) * 100)) : 0;
---

{uv && uv.indice > 0 && (
  <section aria-label="Índice UV">
    <h2 class="mb-3 flex items-center gap-2 text-base font-semibold text-foreground">
      <span aria-hidden="true">☀️</span> Índice UV
    </h2>
    <div class="rounded-lg border border-border bg-card p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-muted-foreground" data-uv-categoria>{uv.categoria}</p>
          <p class={`text-3xl font-bold tabular-nums ${corUV(uv.indice)}`} data-uv-indice>
            {uv.indice.toFixed(1)}
          </p>
        </div>
        <div class="text-right text-xs text-muted-foreground">
          {uv.pico_inicio && uv.pico_fim && (
            <p>Pico: {uv.pico_inicio}–{uv.pico_fim}</p>
          )}
          <p class="mt-1">Fonte: {uv.fonte}</p>
        </div>
      </div>
      <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-muted">
        <div
          class={`h-full rounded-full transition-all ${barraUV(uv.indice)}`}
          style={`width: ${pct}%`}
          data-uv-barra
          role="progressbar"
          aria-label="Índice UV"
          aria-valuenow={uv.indice}
          aria-valuemin={0}
          aria-valuemax={12}
        />
      </div>
      <div class="mt-2 flex justify-between text-xs text-muted-foreground">
        <span>Baixo</span><span>Mod.</span><span>Alto</span><span>M.Alto</span><span>Extremo</span>
      </div>
    </div>
  </section>
)}
